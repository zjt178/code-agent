# 模型（Ollama）
CODEAGENT_LLM=ollama
CODEAGENT_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
CODEAGENT_LLM_TIMEOUT=120

# embedding: auto | ollama | hash
CODEAGENT_EMBED=auto
CODEAGENT_EMBED_MODEL=qllama/bge-small-zh-v1.5:latest

# 仓库护栏
CODEAGENT_MAX_FILES=400
CODEAGENT_MAX_REPO_MB=60
CODEAGENT_CLONE_TIMEOUT=120

# Agent
CODEAGENT_MAX_TARGETS=8
CODEAGENT_MAX_REPAIR=2
# 结论里是否包含 info 级建议（缺 docstring 等）
CODEAGENT_INCLUDE_INFO=0

# 报告与生成测试的落盘目录
CODEAGENT_STORAGE=storage
